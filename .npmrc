# 国内镜像加速：npm 包源
registry=https://registry.npmmirror.com/

# Electron 二进制走国内镜像（npmmirror 路径不带 v 前缀，需配合 CUSTOM_DIR）
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ELECTRON_CUSTOM_DIR={{ version }}

# electron-builder 打包时下载的 winCodeSign / nsis 等工具也走国内镜像
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/

# **pnpm v11+ 的供应链安全校验**：默认要求包发布后至少等待**1 天 (1440 分钟)**才允许安装。设置跳过
minimum-release-age=0
# 关闭构建脚本审批，允许所有包执行install脚本
allow-build-scripts=true

only-built-dependencies: [
    "electron",
    "esbuild",
    "vue-demi"
]